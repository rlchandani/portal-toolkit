<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Guest card setup: list nearby Wi-Fi networks and the connected one to pick from.
         Android ties Wi-Fi scan results and the connected SSID to location (fine + coarse are
         requested together since API 31); API 33+ also asks for nearby Wi-Fi devices. Requested
         only when the network picker opens; never used to derive location. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Google Photos import uses the session-based Picker API: the user selects
         photos in Google's own hosted UI (Custom Tab), so NO media-read permission
         (READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE) is required. INTERNET above is
         enough to talk to photospicker.googleapis.com and download the picked bytes. -->

    <!--
         QUERY_ALL_PACKAGES is needed to list installed apps and send them
         to the Portal. Google Play restricts this permission to categories
         such as file managers, device-management tools, or browsers, and it
         requires an explicit declaration in Play Console.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".PortalApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PortalInstaller">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PortalInstaller">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
            <!-- Share to Portal: Android share sheet entry, background retry job and actions. -->
        <activity android:name=".share.ShareActivity" android:exported="true"
            android:theme="@style/Theme.PortalInstaller.Share" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity android:name=".share.ShareJobActivity" android:exported="false"
            android:theme="@style/Theme.PortalInstaller.Share" />
        <service android:name=".share.ShareRetryJobService"
            android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <receiver android:name=".share.ShareActionReceiver" android:exported="false" />
    </application>

</manifest>
